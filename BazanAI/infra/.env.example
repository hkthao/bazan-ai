# Bazan AI - Infrastructure Configuration
# ==========================================

# MongoDB Replica Set
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=bazan_secret_password
MONGO_REPLICA_SET_NAME=rs0

# Redis
REDIS_PASSWORD=bazan_redis_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=bazan_user
RABBITMQ_DEFAULT_PASS=bazan_password

# MinIO (S3 Compatible Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Qdrant (Vector Database)
QDRANT_API_KEY=

# Seq (Log Aggregator)
ACCEPT_EULA=Y

# API & Security
# ==========================================
JWT_SECRET=bazan_ai_very_long_and_secure_jwt_secret_key_2026
JWT_EXPIRY_HOURS=24
PII_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f # 32-byte hex key
OTP_PEPPER=bazan_otp_pepper_secret_2026

# External APIs (Placeholders)
# ==========================================
# AI Models (OpenAI or Azure OpenAI)
AI_PROVIDER=OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# Messaging & Weather
ZALO_OA_ACCESS_TOKEN=your_zalo_token
ZALO_OA_OTP_TEMPLATE=your_zalo_template_id
FCM_SERVER_KEY=your_fcm_key
OPENWEATHER_API_KEY=your_openweather_key

# Services Connectivity (Internal for Docker)
# ==========================================
IDENTITY_SVC_URL=http://identity-svc:8080
CONVERSATION_SVC_URL=http://conversation-svc:8080
AGRONOMY_SVC_URL=http://agronomy-svc:8080
MARKET_SVC_URL=http://market-svc:8080
KNOWLEDGE_RAG_URL=http://knowledge-rag-svc:8000

# Connection Strings (Template)
# ==========================================
MONGO_CONNECTION_STRING=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
REDIS_CONNECTION_STRING=redis:6379,password=bazan_redis_password
RABBITMQ_CONNECTION_STRING=amqp://bazan_user:bazan_password@rabbitmq:5672
