{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/{remainder}" }
        ]
      },
      "conversation-route": {
        "ClusterId": "conversation-cluster",
        "Match": {
          "Path": "/api/conversations/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/{remainder}" }
        ]
      },
      "orchestrator-route": {
        "ClusterId": "orchestrator-cluster",
        "Match": {
          "Path": "/api/orchestrator/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/{remainder}" }
        ]
      },
      "agronomy-route": {
        "ClusterId": "agronomy-cluster",
        "Match": {
          "Path": "/api/agronomy/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/{remainder}" }
        ]
      },
      "market-route": {
        "ClusterId": "market-cluster",
        "Match": {
          "Path": "/api/market/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/{remainder}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-svc:8080"
          }
        }
      },
      "conversation-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://conversation-svc:8080"
          }
        }
      },
      "orchestrator-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orchestrator-svc:8080"
          }
        }
      },
      "agronomy-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://agronomy-svc:8080"
          }
        }
      },
      "market-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://market-svc:8080"
          }
        }
      }
    }
  }
}
